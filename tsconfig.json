{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"types": ["chrome", "node"],
		"lib": ["es2022", "dom"],
		"verbatimModuleSyntax": true,
		"strictNullChecks": false,
		"noImplicitAny": false,
		"paths": {
			"@/*": ["./src/*"],
			"@core/*": ["./src/core/*"],
			"@settings/*": ["./src/settings/*"],
			"@ui/*": ["./src/ui/*"],
			"@extensions/*": ["./src/extensions/*"],
			"@shared/*": ["./src/shared/*"],
			"@renderers/*": ["./src/ui/settings/views/*"],
			"@controls/*": ["./src/ui/settings/views/controls/*"],
			"@base/*": ["./src/ui/settings/views/base/*"],
			"@editor/*": ["./src/ui/settings/views/base/editor/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.svelte.ts", "utils/**/*.ts", "eslint.config.mts"],
	"exclude": ["node_modules"]
}
